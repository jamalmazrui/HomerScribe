# Generated at build time; never edited, never committed.
Version.cs

# Logs, from the build, from runs, and from the repository script.
*.log
*.obj
*.pdb

# Maintainer scripts, not part of the distribution
tagRelease.*
createHomerDescribeRepo.cmd
createHomerDescribeRepo.ps1
createHomerDescribeRepo.log

# Results of describing a film. Each video gets a folder of its own named after
# it, so nothing here can be matched by a pattern; keep results out of the
# repository by describing into a folder outside it.
work/

# The settings file and the working files live under %LOCALAPPDATA%\HomerDescribe
# and never appear here.

# Companion programs. The installer packages them from this folder when they
# are here, but they are far too large to belong in the repository.
ffmpeg.exe
ffprobe.exe
ffplay.exe
yt-dlp.exe
youtube-dl.exe

# Editor and system clutter
Thumbs.db
desktop.ini
