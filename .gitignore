# .gitignore for HomerScribe, generated by tidy on 2026-10-08.
#
# THIS IS A WHITELIST. Everything is ignored, and then exactly what
# RepoFiles.txt names is put back. A file dropped into this folder is
# invisible to git until somebody names it there, which is the point: the
# file that gets pushed by accident is always the one nobody thought of.
#
# To add a file to the repository, add one line to RepoFiles.txt and run
# tidy again. Do not edit this file by hand; it is overwritten.

# Ignore everything.
/*

# Put back what the project names.
!/.gitattributes
!/.gitignore
!/build.cmd
!/help/
!/HomerScribe.cs
!/HomerScribe.exe.config
!/HomerScribe_setup.iss
!/License.htm
!/License.md
!/LocalFiles.txt
!/pdfpig.name
!/ReadMe.htm
!/ReadMe.md
!/RepoFiles.txt
!/scripts/
!/templates/
!/.gitignore
!/.gitattributes
!/KeepEncoding.txt

# On this disk only, from LocalFiles.txt.
logs/
exec/
work/
notes/
packages/
version.txt
Version.cs
HomerScribe_setup.exe
createHomerScribeRepo.cmd
createHomerScribeRepo.ps1
scripts/release.cmd
scripts/release.ps1

# Never pushed, whatever RepoFiles.txt says: private notes, maintainer
# scripts, logs, and anything a build makes.
*.exe
*.jsb
*.log
*.obj
*.pdb
Version.cs
__pycache__/
.venv/
build/
create*Repo.cmd
create*Repo.ps1
